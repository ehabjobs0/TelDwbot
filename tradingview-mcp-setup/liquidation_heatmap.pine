//@version=5
// =============================================================================
//  Estimated Liquidation Heatmap (ZONES + ALERTS)  — free TRDR/Coinglass alt
// -----------------------------------------------------------------------------
//  HOW IT WORKS (read this):
//  Pine Script has NO access to real exchange order books or open interest, so a
//  true liquidation feed is impossible. This script ESTIMATES where leveraged
//  positions are likely to get liquidated and draws them as COLORED ZONES (boxes):
//    * A swing HIGH = where shorts likely opened  -> liquidation zones ABOVE (red)
//    * A swing LOW  = where longs likely opened    -> liquidation zones BELOW (green)
//  Zones are semi-transparent and volume-weighted, so where many zones OVERLAP the
//  area gets darker/hotter — just like a real liquidation heatmap.
//  A "magnet" table shows the nearest cluster above/below price + a bias hint.
//
//  ALERTS: fires when price ENTERS a zone, or APPROACHES a large liq cluster.
//  To use: add the indicator, then create an alert with condition
//          "LIQ Heatmap" -> "Any alert() function call".
//
//  Output is designed to be READ BY THE tradingview-mcp:
//    * box.new    -> data_get_pine_boxes  (liquidation zones as {high, low})
//    * label.new  -> data_get_pine_labels ("LIQ SHORT 50x 0.6543")
//    * table.new  -> data_get_pine_tables (nearest magnet + bias hint)
//  Use study_filter="Liquidation" when querying the MCP.
// =============================================================================
indicator("Liquidation Heatmap (Estimated)", shorttitle="LIQ Heatmap", overlay=true, max_boxes_count=500, max_labels_count=500)

// ---------- Inputs: swing detection ----------
gP     = "Swing detection"
pivLen = input.int(15, "Swing strength (left/right bars)", minval=2, group=gP, tooltip="Bigger = only major swings, fewer/cleaner zones")
volLen = input.int(50, "Volume baseline length", minval=5, group=gP)

// ---------- Inputs: leverage tiers ----------
gL   = "Leverage tiers"
lev1 = input.int(10,  "Tier 1 (x)", minval=2, group=gL)
lev2 = input.int(25,  "Tier 2 (x)", minval=2, group=gL)
lev3 = input.int(50,  "Tier 3 (x)", minval=2, group=gL)
lev4 = input.int(100, "Tier 4 (x)", minval=2, group=gL)
mmr  = input.float(0.005, "Maintenance margin rate", step=0.001, group=gL, tooltip="~0.4-0.5% on major perps")

// ---------- Inputs: display ----------
gV         = "Display"
zonePct    = input.float(0.25, "Zone thickness (% of price)", minval=0.02, step=0.05, group=gV, tooltip="Half above / half below each liquidation price")
maxZones   = input.int(120, "Max zones kept on chart", minval=10, maxval=480, group=gV)
extendBars = input.int(80, "Zone length (bars right)", minval=5, group=gV)
showLabels = input.bool(false, "Show price labels on zones", group=gV)
volWeight  = input.bool(true, "Weight intensity by volume", group=gV)
longCol    = input.color(color.lime, "Long-liq color (below price)", group=gV)
shortCol   = input.color(color.red,  "Short-liq color (above price)", group=gV)

// ---------- Inputs: magnet table ----------
gT        = "Magnet table"
showTable = input.bool(true, "Show nearest-cluster table", group=gT)

// ---------- Inputs: alerts ----------
gA           = "Alerts"
alertsOn     = input.bool(true,  "Enable alerts", group=gA)
proximityPct = input.float(0.5,  "Alert when price within (%) of cluster", minval=0.05, step=0.05, group=gA)
clusterBand  = input.float(0.4,  "Cluster band (%) — group overlapping zones", minval=0.05, step=0.05, group=gA)
minCluster   = input.int(2,      "Min zones in cluster to alert", minval=1, group=gA)

// ---------- State arrays (parallel) ----------
var box[]   bxs    = array.new_box()
var label[] lbs    = array.new_label()
var float[] prices = array.new_float()
var int[]   sides  = array.new_int()   // 1 = short-liq (above), -1 = long-liq (below)

// ---------- Volume-based intensity (transparency) ----------
vAvg   = ta.sma(volume, volLen)
vAtPiv = volume[pivLen]
relVol = vAvg > 0 ? vAtPiv / vAvg : 1.0
// Higher volume -> lower transparency (hotter). Kept high overall so OVERLAPS stack.
transp = volWeight ? int(math.max(55, math.min(92, 92 - relVol * 15))) : 80

// ---------- Helper: add one liquidation zone ----------
addZone(float price, int side, color baseCol, string sideTxt, int lev) =>
    half = price * (zonePct / 100.0) / 2.0
    top  = price + half
    bot  = price - half
    col  = color.new(baseCol, transp)
    bx   = box.new(bar_index - pivLen, top, bar_index + extendBars, bot, border_color=color.new(baseCol, math.min(99, transp + 5)), border_width=1, bgcolor=col)
    array.push(bxs, bx)
    array.push(prices, price)
    array.push(sides, side)
    label lb = na
    if showLabels
        txt = "LIQ " + sideTxt + " " + str.tostring(lev) + "x " + str.tostring(price, format.mintick)
        lb := label.new(bar_index + extendBars, price, txt, style=label.style_label_left, color=color.new(baseCol, 75), textcolor=color.white, size=size.tiny)
    array.push(lbs, lb)
    // trim oldest to respect the cap
    if array.size(bxs) > maxZones
        box.delete(array.shift(bxs))
        label.delete(array.shift(lbs))
        array.shift(prices)
        array.shift(sides)

// ---------- Detect swings ----------
ph   = ta.pivothigh(high, pivLen, pivLen)
pl   = ta.pivotlow(low,  pivLen, pivLen)
levs = array.from(lev1, lev2, lev3, lev4)

// Swing HIGH -> shorts opened ~ here -> liquidation zones ABOVE
if not na(ph)
    for L in levs
        liq = ph * (1 + 1.0 / L - mmr)
        addZone(liq, 1, shortCol, "SHORT", L)

// Swing LOW -> longs opened ~ here -> liquidation zones BELOW
if not na(pl)
    for L in levs
        liq = pl * (1 - 1.0 / L + mmr)
        addZone(liq, -1, longCol, "LONG", L)

// ---------- Shared nearest-cluster metrics (used by table + alerts) ----------
float nAbove   = na
float nBelow   = na
int   cAbove   = 0
int   cBelow   = 0
int   strAbove = 0
int   strBelow = 0
bool  insideZone = false
int   n = array.size(prices)
needMetrics = showTable or alertsOn
if needMetrics and n > 0
    // pass 1: nearest above/below + counts + inside-zone test
    for i = 0 to n - 1
        float p = array.get(prices, i)
        float half = p * (zonePct / 100.0) / 2.0
        if math.abs(close - p) <= half
            insideZone := true
        if p > close
            cAbove += 1
            if na(nAbove) or p < nAbove
                nAbove := p
        else if p < close
            cBelow += 1
            if na(nBelow) or p > nBelow
                nBelow := p
    // pass 2: how many zones cluster around the nearest level (strength)
    for i = 0 to n - 1
        float p = array.get(prices, i)
        if not na(nAbove) and math.abs(p - nAbove) / nAbove * 100.0 <= clusterBand
            strAbove += 1
        if not na(nBelow) and math.abs(p - nBelow) / nBelow * 100.0 <= clusterBand
            strBelow += 1

// ---------- Magnet table ----------
var table t = na
if showTable and barstate.islast
    if na(t)
        t := table.new(position.top_right, 2, 5, border_width=1, frame_color=color.gray, frame_width=1)
    string hint = cBelow > cAbove ? "Heavier BELOW: downside liquidity (long-squeeze / sweep low)" : cAbove > cBelow ? "Heavier ABOVE: upside liquidity (short-squeeze / sweep high)" : "Balanced"
    table.cell(t, 0, 0, "LIQ MAGNET", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.small)
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 0))
    table.cell(t, 0, 1, "Nearest ABOVE", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, na(nAbove) ? "-" : str.tostring(nAbove, format.mintick) + "  (" + str.tostring(strAbove) + ")", text_color=color.red, text_size=size.small)
    table.cell(t, 0, 2, "Nearest BELOW", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, na(nBelow) ? "-" : str.tostring(nBelow, format.mintick) + "  (" + str.tostring(strBelow) + ")", text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 3, "Zones above/below", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(cAbove) + " / " + str.tostring(cBelow), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "Bias hint", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, hint, text_color=color.yellow, text_size=size.small)

// ---------- Alerts ----------
if alertsOn and barstate.isconfirmed
    float distAbove = na(nAbove) ? na : (nAbove - close) / close * 100.0
    float distBelow = na(nBelow) ? na : (close - nBelow) / close * 100.0
    if insideZone
        alert("LIQ HEATMAP: price INSIDE a liquidation zone @ " + str.tostring(close, format.mintick) + " (" + syminfo.ticker + " " + timeframe.period + ")", alert.freq_once_per_bar)
    else
        if not na(distAbove) and distAbove <= proximityPct and strAbove >= minCluster
            alert("LIQ HEATMAP: approaching SHORT-liq cluster ABOVE @ " + str.tostring(nAbove, format.mintick) + " (" + str.tostring(strAbove) + " zones). Possible sweep up / short squeeze. " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)
        if not na(distBelow) and distBelow <= proximityPct and strBelow >= minCluster
            alert("LIQ HEATMAP: approaching LONG-liq cluster BELOW @ " + str.tostring(nBelow, format.mintick) + " (" + str.tostring(strBelow) + " zones). Possible sweep low / long squeeze. " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)
