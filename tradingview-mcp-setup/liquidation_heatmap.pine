//@version=5
// =============================================================================
//  Estimated Liquidation Heatmap (MERGED ZONES + ALERTS) — free TRDR/Coinglass alt
// -----------------------------------------------------------------------------
//  HOW IT WORKS (read this):
//  Pine Script has NO access to real exchange order books or open interest, so a
//  true liquidation feed is impossible. This script ESTIMATES where leveraged
//  positions are likely to get liquidated and draws them as COLORED ZONES (boxes):
//    * A swing HIGH = where shorts likely opened  -> liquidation zones ABOVE (red)
//    * A swing LOW  = where longs likely opened    -> liquidation zones BELOW (green)
//  Liquidation prices for leverage tiers 10/25/50/100x are collected from every
//  swing, then NEARBY LEVELS ARE MERGED into a single cleaner zone. The more levels
//  merged, the FATTER and HOTTER (darker) the zone = a stronger liquidity wall.
//  Each merged zone is tagged "xN" = how many liquidation levels stacked there.
//  A "magnet" table shows the nearest cluster above/below price + a bias hint.
//
//  ALERTS: fires when price ENTERS a zone, or APPROACHES a large liq cluster.
//  To use: add the indicator, then create an alert with condition
//          "LIQ Heatmap" -> "Any alert() function call".
//
//  Read by the tradingview-mcp via: data_get_pine_boxes (zones {high,low}),
//  data_get_pine_labels (xN tags), data_get_pine_tables (magnet). study_filter="Liquidation".
// =============================================================================
indicator("Liquidation Heatmap (Estimated)", shorttitle="LIQ Heatmap", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=20)

// ---------- Inputs: swing detection ----------
gP     = "Swing detection"
pivLen = input.int(15, "Swing strength (left/right bars)", minval=2, group=gP, tooltip="Bigger = only major swings, fewer/cleaner zones")

// ---------- Inputs: leverage tiers ----------
gL   = "Leverage tiers"
lev1 = input.int(10,  "Tier 1 (x)", minval=2, group=gL)
lev2 = input.int(25,  "Tier 2 (x)", minval=2, group=gL)
lev3 = input.int(50,  "Tier 3 (x)", minval=2, group=gL)
lev4 = input.int(100, "Tier 4 (x)", minval=2, group=gL)
mmr  = input.float(0.005, "Maintenance margin rate", step=0.001, group=gL, tooltip="~0.4-0.5% on major perps")

// ---------- Inputs: merge / display ----------
gV         = "Merge & display"
mergeOn    = input.bool(true, "Merge nearby zones", group=gV, tooltip="Combine liquidation levels that fall within the band below into one cleaner, stronger zone")
mergeBand  = input.float(0.30, "Merge band (% of price)", minval=0.0, step=0.05, group=gV, tooltip="Levels closer than this get merged together")
zonePct    = input.float(0.20, "Min zone thickness (% of price)", minval=0.02, step=0.05, group=gV)
maxRaw     = input.int(240, "Max raw levels kept", minval=20, maxval=480, group=gV)
extendBars = input.int(80, "Zone length (bars right)", minval=5, group=gV)
showLabels = input.bool(true, "Show xN strength tags", group=gV)
longCol    = input.color(color.lime, "Long-liq color (below price)", group=gV)
shortCol   = input.color(color.red,  "Short-liq color (above price)", group=gV)

// ---------- Inputs: magnet table ----------
gT        = "Magnet table"
showTable = input.bool(true, "Show nearest-cluster table", group=gT)

// ---------- Inputs: nearest-wall pointer ----------
gW       = "Nearest-wall pointer"
showWall = input.bool(true, "Show dotted line to nearest wall", group=gW, tooltip="Dotted line from current price to the nearest liquidity wall above and below, with distance %")

// ---------- Inputs: alerts ----------
gA           = "Alerts"
alertsOn     = input.bool(true,  "Enable alerts", group=gA)
proximityPct = input.float(0.5,  "Alert when price within (%) of cluster", minval=0.05, step=0.05, group=gA)
minCluster   = input.int(2,      "Min merged levels (xN) to alert", minval=1, group=gA)

// ---------- State: raw liquidation levels ----------
var float[] rawP  = array.new_float()   // raw liquidation price
var int[]   rawS  = array.new_int()     // side: 1 = short-liq (above), -1 = long-liq (below)

// ---------- State: drawn objects + merged-zone metadata ----------
var box[]   bxs   = array.new_box()
var label[] lbs   = array.new_label()
var float[] zCen  = array.new_float()
var float[] zTop  = array.new_float()
var float[] zBot  = array.new_float()
var int[]   zCnt  = array.new_int()
var int[]   zSide = array.new_int()

// ---------- Helper: store one raw liquidation level ----------
pushRaw(float price, int side) =>
    array.push(rawP, price)
    array.push(rawS, side)
    if array.size(rawP) > maxRaw
        array.shift(rawP)
        array.shift(rawS)

// ---------- Helper: draw one merged zone [lo..hi] of cnt levels ----------
emitCluster(float lo, float hi, int cnt, int side, color baseCol) =>
    center = (lo + hi) / 2.0
    half   = center * (zonePct / 100.0) / 2.0
    top    = hi + half
    bot    = lo - half
    tp     = int(math.max(40, math.min(88, 86 - cnt * 9)))   // more merged = hotter (less transparent)
    bx     = box.new(bar_index - pivLen, top, bar_index + extendBars, bot, border_color=color.new(baseCol, math.min(95, tp + 5)), border_width=1, bgcolor=color.new(baseCol, tp))
    array.push(bxs, bx)
    if showLabels and cnt >= 2
        lb = label.new(bar_index + extendBars, center, "x" + str.tostring(cnt), style=label.style_label_left, color=color.new(baseCol, 70), textcolor=color.white, size=size.tiny)
        array.push(lbs, lb)
    array.push(zCen, center)
    array.push(zTop, top)
    array.push(zBot, bot)
    array.push(zCnt, cnt)
    array.push(zSide, side)

// ---------- Detect swings, store raw levels ----------
ph   = ta.pivothigh(high, pivLen, pivLen)
pl   = ta.pivotlow(low,  pivLen, pivLen)
levs = array.from(lev1, lev2, lev3, lev4)

if not na(ph)
    for L in levs
        pushRaw(ph * (1 + 1.0 / L - mmr), 1)    // shorts -> liquidate above
if not na(pl)
    for L in levs
        pushRaw(pl * (1 - 1.0 / L + mmr), -1)   // longs  -> liquidate below

newPivot = (not na(ph)) or (not na(pl))

// ---------- Rebuild merged zones whenever a new swing appears ----------
effBand = mergeOn ? mergeBand : 0.0
if newPivot
    // clear previous drawings + metadata
    while array.size(bxs) > 0
        box.delete(array.shift(bxs))
    while array.size(lbs) > 0
        label.delete(array.shift(lbs))
    array.clear(zCen)
    array.clear(zTop)
    array.clear(zBot)
    array.clear(zCnt)
    array.clear(zSide)
    int nr = array.size(rawP)
    // cluster each side separately
    for s = 0 to 1
        int   sideVal = s == 0 ? 1 : -1
        color baseCol = sideVal == 1 ? shortCol : longCol
        tmp = array.new_float()
        if nr > 0
            for i = 0 to nr - 1
                if array.get(rawS, i) == sideVal
                    array.push(tmp, array.get(rawP, i))
        int szt = array.size(tmp)
        if szt > 0
            array.sort(tmp, order.ascending)
            float lo    = array.get(tmp, 0)
            float prevv = lo
            int   cnt   = 1
            if szt > 1
                for k = 1 to szt - 1
                    float cur = array.get(tmp, k)
                    if (cur - prevv) / prevv * 100.0 <= effBand
                        prevv := cur
                        cnt   += 1
                    else
                        emitCluster(lo, prevv, cnt, sideVal, baseCol)
                        lo    := cur
                        prevv := cur
                        cnt   := 1
            emitCluster(lo, prevv, cnt, sideVal, baseCol)

// ---------- Shared nearest-cluster metrics (table + alerts) ----------
float nAbove    = na
float nBelow    = na
int   nAboveCnt = 0
int   nBelowCnt = 0
int   sumAbove  = 0
int   sumBelow  = 0
bool  insideZone = false
int   nz = array.size(zCen)
if nz > 0
    for i = 0 to nz - 1
        float c  = array.get(zCen, i)
        float tp_ = array.get(zTop, i)
        float bt_ = array.get(zBot, i)
        int   ct  = array.get(zCnt, i)
        if close >= bt_ and close <= tp_
            insideZone := true
        if c > close
            sumAbove += ct
            if na(nAbove) or c < nAbove
                nAbove    := c
                nAboveCnt := ct
        else if c < close
            sumBelow += ct
            if na(nBelow) or c > nBelow
                nBelow    := c
                nBelowCnt := ct

// ---------- Magnet table ----------
var table t = na
if showTable and barstate.islast
    if na(t)
        t := table.new(position.top_right, 2, 5, border_width=1, frame_color=color.gray, frame_width=1)
    string hint = sumBelow > sumAbove ? "Heavier BELOW: downside liquidity (long-squeeze / sweep low)" : sumAbove > sumBelow ? "Heavier ABOVE: upside liquidity (short-squeeze / sweep high)" : "Balanced"
    table.cell(t, 0, 0, "LIQ MAGNET", text_color=color.white, bgcolor=color.new(color.blue, 0), text_size=size.small)
    table.cell(t, 1, 0, "", bgcolor=color.new(color.blue, 0))
    table.cell(t, 0, 1, "Nearest ABOVE", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, na(nAbove) ? "-" : str.tostring(nAbove, format.mintick) + "  x" + str.tostring(nAboveCnt), text_color=color.red, text_size=size.small)
    table.cell(t, 0, 2, "Nearest BELOW", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, na(nBelow) ? "-" : str.tostring(nBelow, format.mintick) + "  x" + str.tostring(nBelowCnt), text_color=color.lime, text_size=size.small)
    table.cell(t, 0, 3, "Liq weight above/below", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(sumAbove) + " / " + str.tostring(sumBelow), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "Bias hint", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, hint, text_color=color.yellow, text_size=size.small)

// ---------- Dotted pointer to nearest wall ----------
var line  lnA = na
var line  lnB = na
var label laA = na
var label laB = na
if showWall and barstate.islast
    line.delete(lnA)
    line.delete(lnB)
    label.delete(laA)
    label.delete(laB)
    int xPos = bar_index + 3
    if not na(nAbove)
        float dA = (nAbove - close) / close * 100.0
        lnA := line.new(xPos, close, xPos, nAbove, xloc=xloc.bar_index, style=line.style_dotted, color=shortCol, width=1)
        laA := label.new(xPos, nAbove, str.tostring(nAbove, format.mintick) + " x" + str.tostring(nAboveCnt) + "  +" + str.tostring(dA, "#.##") + "%", style=label.style_label_down, color=color.new(shortCol, 25), textcolor=color.white, size=size.small)
    if not na(nBelow)
        float dB = (close - nBelow) / close * 100.0
        lnB := line.new(xPos, close, xPos, nBelow, xloc=xloc.bar_index, style=line.style_dotted, color=longCol, width=1)
        laB := label.new(xPos, nBelow, str.tostring(nBelow, format.mintick) + " x" + str.tostring(nBelowCnt) + "  -" + str.tostring(dB, "#.##") + "%", style=label.style_label_up, color=color.new(longCol, 25), textcolor=color.white, size=size.small)

// ---------- Alerts ----------
if alertsOn and barstate.isconfirmed
    float distAbove = na(nAbove) ? na : (nAbove - close) / close * 100.0
    float distBelow = na(nBelow) ? na : (close - nBelow) / close * 100.0
    if insideZone
        alert("LIQ HEATMAP: price INSIDE a liquidation zone @ " + str.tostring(close, format.mintick) + " (" + syminfo.ticker + " " + timeframe.period + ")", alert.freq_once_per_bar)
    else
        if not na(distAbove) and distAbove <= proximityPct and nAboveCnt >= minCluster
            alert("LIQ HEATMAP: approaching SHORT-liq cluster ABOVE @ " + str.tostring(nAbove, format.mintick) + " (x" + str.tostring(nAboveCnt) + "). Possible sweep up / short squeeze. " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)
        if not na(distBelow) and distBelow <= proximityPct and nBelowCnt >= minCluster
            alert("LIQ HEATMAP: approaching LONG-liq cluster BELOW @ " + str.tostring(nBelow, format.mintick) + " (x" + str.tostring(nBelowCnt) + "). Possible sweep low / long squeeze. " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar)
